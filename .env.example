# SmartCRM Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Email / SMS providers are connected per user in Settings → Email & SMS providers.
# Credentials are stored encrypted; set the server-side encryption key (64 hex chars or 32-byte base64):
MESSAGING_ENCRYPTION_KEY=
# REQUIRED for inbound-email-webhook (it refuses all requests without a configured secret).
# Accepts HMAC-SHA256 of the raw body (X-Webhook-Signature), X-Webhook-Secret, Basic-auth password or ?token=
INBOUND_EMAIL_WEBHOOK_SECRET=
# Mailgun signing key (verifies body.signature on Mailgun routes) - alternative to the secret above
MAILGUN_WEBHOOK_SECRET=
# Optional: lets you invoke scheduled functions manually (x-cron-secret header); Netlify's scheduler needs no secret
CRON_SECRET=

# SDR Assistant Configuration (optional - will be auto-created if not set)
SDR_ASSISTANT_ID=your_openai_assistant_id_here

# Supabase Database Configuration
SUPABASE_URL=https://gadedbrnqzpfqtsdfzcg.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdhZGVkYnJucXpwZnF0c2RmemNnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDI1NjYxMTUsImV4cCI6MjA1ODE0MjExNX0.bpsk8yRpwQQnYaY4qY3hsW5ExrQe_8JA3UZ51mlQ1e4

# Netlify URL (auto-populated in production)
URL=https://your-netlify-site.netlify.app

# Note: Service role key should be set in Netlify environment variables only
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Model Configuration (GPT-5.2 Upgrade)
SMARTCRM_MODEL=gpt-5.2
SMARTCRM_THINKING_MODEL=gpt-5.2-thinking
SMARTCRM_FAST_MODEL=gpt-5.2-instant
